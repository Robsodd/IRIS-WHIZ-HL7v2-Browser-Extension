{
  "name": "IRIS Whiz",
  "description": "Enhances the HL7 V2 experience in Intersystems IRIS/Ensemble.",
  "version": "1.11.0",
  "manifest_version": 3,
  "permissions": [ "scripting", "tabs", "tabGroups", "storage", "contextMenus", "bookmarks", "sidePanel"],
  "optional_host_permissions": ["*://*/*"],
  "options_page": "pages/options.html",
  "background": {
	"service_worker": "background.js"
	},
  "action": {
	"default_popup": "pages/popup.html"  
  },
  "icons": {
    "48": "icons/Icon48.png",
    "128": "icons/Icon128.png"
  },
  "side_panel": {
    "default_path": "pages/popup.html"
  }
 }
